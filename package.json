{
  "name": "signal-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file=.env server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "db:up": "docker compose up -d db",
    "db:seed": "node --env-file=.env scripts/seed-memes.js",
    "db:migrate:auth": "node --env-file=.env scripts/migrate-auth.js",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec db psql -U signal -d signal_studio",
    "test": "node --test",
    "eval:memes": "node --env-file=.env scripts/evaluate-memes.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.1",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^10.0.5",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "~5.8.3",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
