# Local development password. Change this before exposing the database beyond localhost.
POSTGRES_PASSWORD=signal-local-dev-change-me
DATABASE_URL = "postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:5432/postgres"

# Optional server-only AI assistance. Leave disabled for deterministic-only operation.
AI_ENABLED=false
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDERS=groq,openrouter
AI_REQUEST_TIMEOUT_MS=5000
AI_TOTAL_TIMEOUT_MS=12000
AI_MAX_RETRIES=1
AI_CACHE_TTL_SECONDS=300
AI_MAX_REQUESTS_PER_WINDOW=20
AI_ALLOW_PAID_MODELS=false
AI_OPENROUTER_SITE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
